# First launch with MODE=demo. auth.py changes it to MODE=live after login.
MODE=demo
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
# ticks = Zerodha KiteTicker streaming; rest = original polling fallback
FEED=ticks
# Browser dashboard broadcast interval (seconds), NOT the tick interval
POLL_SECONDS=2
# Server remains localhost-only unless you explicitly choose otherwise.
