HISTORY_CALL_SPACING=0.55
HISTORY_SYMBOL_PAUSE=0.20
HISTORY_MAX_ATTEMPTS=2
HISTORY_RETRY_DELAY=90
CHART_HISTORY_REFRESH_SECONDS=600
