# premium-2.4-session-pressure. This file is documentation, not automatically loaded.
KITE_API_KEY=your_kite_api_key
KITE_ACCESS_TOKEN=your_daily_kite_access_token
# Optional locally; on Render use /etc/secrets/numbers.txt with a Secret File.
ACCESS_NUMBERS_FILE=
PORT=8050
SEED_DAYS_5M=45
SEED_DAYS_DAILY=120
SCAN_COMPUTE_EVERY_SEC=3
RECONCILE_EVERY_SEC=180
TICK_STALE_SEC=20
CACHE_STALE_SEC=30
VOLUME_BASELINE_SESSIONS=20
MIN_VOLUME_SESSIONS=10
LIQUIDITY_MIN_TURNOVER=50000000
LIQUIDITY_MAX_SPREAD_BPS=10
LIQUIDITY_MIN_SIDE_DEPTH=100000
BOOSTER_MIN_RVOL=1.5
# Backend confirmation TTL after the candle closes; frontend alert cap is 90s.
SIGNAL_TTL_SEC=90
BUILDING_MAX_GAP_PCT=0.5
BUILDING_MIN_RVOL=1.0
# Session pressure threshold (%) since 09:15; depth alignment and latest 5m
# volume spike are optional session-watchlist checks, required for confirmation.
# The legacy 5m API still requires depth/candle/spike together.
# Not actual executed buy/sell volume; not cumulative intraday RVOL.
# Frontend reads these thresholds and MIN_VOLUME_SESSIONS from the API.
# Frontend retains maximum 20s quote/depth/peer and 30s cache/computation ages;
# wider stale/TTL settings do not widen those conservative browser limits.
IMBALANCE_MIN_PCT=20
IMBALANCE_MIN_BAR_RVOL=1.5
