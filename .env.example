# Live feed changes display-only charts. This application NEVER places orders.

# Optional persistent disk on Render: HISTORY_CACHE_DIR=/var/data/orderflow-history
# HISTORY_CACHE_DIR=.cache/history

# Render Free optimizations: one chart history fetch at a time, small RAM cache.
